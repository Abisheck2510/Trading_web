{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/yf/:path*", "destination": "/api/proxy?target=yf&path=:path*" },
    { "source": "/nse/:path*", "destination": "/api/proxy?target=nse&path=:path*" }
  ]
}
